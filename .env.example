# All variables are optional. Without a database the library is read-only; without a
# cloud token the cloud tab asks the visitor to connect one.

# Neon / Postgres connection string for user-added inserts and categories
DATABASE_URL=

# When set, library mutations require this token (header x-mixture-edit-token; the UI
# asks for it once and keeps it in the browser)
MIXTURE_EDIT_TOKEN=

# Changelog source (defaults to lumenpearson/mixture) and an optional token that lifts
# the GitHub API rate limit
MIXTURE_GITHUB_REPO=lumenpearson/mixture
MIXTURE_GITHUB_TOKEN=

# Cloud drive: the private repository, its branch, a server token with `contents`
# read/write on that repository, and extra owner logins (comma separated)
MIXTURE_CLOUD_REPO=lumenpearson/mixture-cloud
MIXTURE_CLOUD_BRANCH=main
MIXTURE_CLOUD_GITHUB_TOKEN=
MIXTURE_CLOUD_OWNERS=lumenpearson

# Absolute site url for metadata (Open Graph); defaults to the Vercel domain
NEXT_PUBLIC_SITE_URL=
