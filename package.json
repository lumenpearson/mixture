{
  "name": "mixture",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm approve-builds && turbo run build --filter=web",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "licenses": "turbo run licenses",
    "generate": "pnpm --filter @mixture/protocol generate",
    "check:protocol-generation": "node scripts/check-protocol-generation.mjs",
    "check": "pnpm check:protocol-generation && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  }
}
