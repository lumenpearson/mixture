{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mixture · screenkit",
  "mainBinaryName": "mixture-screenkit",
  "version": "0.1.0",
  "identifier": "ru.mixture.screenkit",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mixture · screenkit",
    "shortDescription": "экранные вставки «Гремучей смеси»",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
