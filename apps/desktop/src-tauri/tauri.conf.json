{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mixture · screenkit",
  "mainBinaryName": "mixture-screenkit",
  "version": "0.1.0",
  "identifier": "ru.mixture.screenkit",
  "build": {
    "frontendDist": "../../web/out/desktop",
    "beforeBuildCommand": "pnpm --filter web build:desktop",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost https: http:",
        "media-src": "'self' data: blob: asset: http://asset.localhost https: http:",
        "connect-src": "'self' data: blob: ipc: http://ipc.localhost asset: http://asset.localhost https: http://localhost:* http://127.0.0.1:* http://[::1]:*",
        "frame-src": "'self' data: blob: https: http:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "mixture · screenkit",
    "shortDescription": "экранные вставки «Гремучей смеси»",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "mixture · screenkit"
      },
      "wix": {
        "language": ["ru-RU"]
      }
    }
  }
}
