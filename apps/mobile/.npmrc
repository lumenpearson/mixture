# React Native autolinking and the gradle build read a flat node_modules tree.
# `pnpm install` is driven from the repository root, so this file only takes
# effect for commands started inside apps/mobile; CI sets the same value as
# NPM_CONFIG_NODE_LINKER for the APK job (see .github/workflows/mobile.yml)
# instead of changing the layout for the whole repository.
node-linker=hoisted
